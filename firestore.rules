rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // campus_sync documents store shared data collections across devices
    // Read: Allowed for public/authenticated viewing across all devices
    // Write: Permitted for synchronized state mutations
    match /campus_sync/{syncKey} {
      allow get, list: if true;
      allow create, update: if isValidId(syncKey) && request.resource.data.updatedAt is string;
      allow delete: if false;
    }

    // Admins collection for role verification
    match /admins/{adminUid} {
      allow read: if true;
      allow write: if false;
    }
  }
}
