# ====================================================================
# Campus Help Zone - Environment Variables Configuration
# Copy this file to `.env` in the root folder, and also add these
# same variables in Vercel Dashboard -> Project Settings -> Environment Variables.
# ====================================================================

# GEMINI_API_KEY: Required for Gemini AI features
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Current web host URL
APP_URL="https://ais-pre-pqb7wjikhn6zb3kusrduly-622384418458.asia-east1.run.app"

# --------------------------------------------------------------------
# 1. Bi-Directional Cloud Live Sync (Google AI Studio <--> Vercel Bridge)
# If using without Firebase, this URL bridges Vercel data directly to the Google AI Studio cloud server!
# --------------------------------------------------------------------
VITE_SYNC_SERVER_URL="https://ais-pre-pqb7wjikhn6zb3kusrduly-622384418458.asia-east1.run.app"
SYNC_SERVER_URL="https://ais-pre-pqb7wjikhn6zb3kusrduly-622384418458.asia-east1.run.app"

# --------------------------------------------------------------------
# 2. Firebase Client Configuration (Cloud Realtime Database)
# When these are set on BOTH Google AI Studio and Vercel, changes made
# on either platform appear on the other in real time (< 100ms)!
# Get these from Firebase Console -> Project Settings -> General -> Your apps -> Web app
# --------------------------------------------------------------------
VITE_FIREBASE_API_KEY="AIzaSyYourApiKeyHere"
VITE_FIREBASE_AUTH_DOMAIN="campus-help-zone.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="campus-help-zone"
VITE_FIREBASE_STORAGE_BUCKET="campus-help-zone.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# --------------------------------------------------------------------
# 3. Designated Initial Administrator Email
# --------------------------------------------------------------------
VITE_ADMIN_EMAIL="nazrulpost75@gmail.com"
